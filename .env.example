# Copy to .env.local and adjust. Never commit real values.

# Postgres connection string. Matches docker-compose.yml for local development;
# on Vercel, use the connection string from your hosted Postgres provider.
DATABASE_URL=postgres://rtm:rtm@localhost:5432/rtm

# Public URL of the site, used for canonical links, the sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string used to hash visitor IP addresses for rate limiting,
# so raw IPs are never stored. Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=replace-with-a-long-random-string

# Outgoing email over SMTP. Works with any provider; see docs/email-setup.md.
# Leave SMTP_HOST empty in development: emails are then saved to .outbox/ instead of sent.
#   Google Workspace: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@yourdomain.com  SMTP_PASSWORD=<app password>
#   Resend:           SMTP_HOST=smtp.resend.com SMTP_PORT=465  SMTP_USER=resend             SMTP_PASSWORD=<API key>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# The sender visitors see. Must be an address your provider allows you to send from.
EMAIL_FROM="Ready to Mingle <hello@example.com>"
